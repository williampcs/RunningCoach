# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Discord
DISCORD_BOT_TOKEN=...
DISCORD_ALLOWED_CHANNEL_ID=123456789012345678

# Intervals.icu（從 intervals.icu/settings 的 Developer settings 取得）
INTERVALS_API_KEY=your_api_key_here
INTERVALS_ATHLETE_ID=0

# Agent 參數（可選，有預設值）
# 主對話（教練對話、排課表、tool use）
CLAUDE_MODEL=claude-opus-5-5
# 主對話思考強度：low / medium / high
CLAUDE_CHAT_EFFORT=medium
# 分用途模型（未設定則沿用 CLAUDE_MODEL）
CLAUDE_MODEL_SUMMARY=claude-haiku-5-5     # 跑後分析摘要
CLAUDE_MODEL_COMPRESS=claude-sonnet-5-5   # 對話壓縮（長期記憶）
CONVERSATION_MAX=20
CONVERSATION_KEEP=10
CONVERSATION_MSG_MAX_CHARS=600
RACE_LOOKAHEAD_DAYS=90
# 已結束、尚未記錄成績的賽事保留在清單中的天數
RACE_LOOKBACK_DAYS=14
# 輸出上限含思考 token（只有實際輸出才計費）
MAX_RESPONSE_TOKENS=16000
