# 自建 Discord bot（apps/discord）的設定。複製為 .env 後填入；.env 不會進版控。
# 變數名稱沿用 v1（Python 版），v1 的 .env 可以直接使用。
#
#   本機執行：npm run dev -w @running-coach/discord（讀取 repo 根目錄的 .env）
#   Docker：  docker run -d --env-file .env -v "$PWD/data:/app/data" running-coach-bot
#
# 網頁版不讀這個檔案，金鑰在網頁的設定頁填寫；薄代理的設定見 apps/proxy/.env.example。
#
# 註解要放在獨立的一行：docker run --env-file 不會去掉行尾的「# …」，會把它當成值的一部分。

# Discord
DISCORD_BOT_TOKEN=...
DISCORD_ALLOWED_CHANNEL_ID=123456789012345678

# Intervals.icu（從 intervals.icu/settings 的 Developer settings 取得）
INTERVALS_API_KEY=your_api_key_here
INTERVALS_ATHLETE_ID=0

# LLM 供應商：anthropic（預設）/ openai / gemini / openai-compatible
LLM_PROVIDER=anthropic

# --- Anthropic（LLM_PROVIDER=anthropic）---
ANTHROPIC_API_KEY=sk-ant-...
# 改連其他相容 Anthropic API 的端點時填寫，例如本機的模擬上游 http://127.0.0.1:8788
# ANTHROPIC_BASE_URL=
# 主對話（教練對話、排課表、tool use）
CLAUDE_MODEL=claude-opus-5-5
# 分用途模型（未設定則沿用主對話模型）：跑後分析摘要、對話壓縮（長期記憶）
CLAUDE_MODEL_SUMMARY=claude-haiku-5-5
CLAUDE_MODEL_COMPRESS=claude-sonnet-5-5
# 主對話思考強度：low / medium / high / xhigh / max
CLAUDE_CHAT_EFFORT=medium

# --- 其他供應商（LLM_PROVIDER=openai / gemini / openai-compatible）---
# 模型 ID 由你填寫，程式不內建；分用途模型未設定則沿用 LLM_MODEL
# LLM_API_KEY=
# LLM_MODEL=
# LLM_MODEL_SUMMARY=
# LLM_MODEL_COMPRESS=
# 主對話思考強度，對應到 low / medium / high（CLAUDE_CHAT_EFFORT 有設定時以它為準）
# LLM_CHAT_EFFORT=medium
# 以下只用於 openai-compatible
# LLM_BASE_URL=https://example.com/v1
# 輸出上限的參數名稱：max_completion_tokens（預設）或 max_tokens
# LLM_MAX_TOKENS_PARAM=max_completion_tokens
# 是否送出 reasoning_effort（只有推理模型接受）
# LLM_REASONING_EFFORT=false

# 時區（IANA 名稱），決定「今天」與一週的起點
TIMEZONE=Asia/Taipei
# 資料庫路徑；預設 /app/data/coach.db（Docker 內），本機執行時可改為 ./data/coach.db
# DB_PATH=

# Agent 參數（可選，有預設值）
CONVERSATION_MAX=20
CONVERSATION_KEEP=10
# 較早的對話每則只帶入前幾字（教練需要時可讀取全文）；最新的幾則（含剛送出的訊息）完整帶入
CONVERSATION_MSG_MAX_CHARS=600
CONVERSATION_FULL_RECENT=3
RACE_LOOKAHEAD_DAYS=90
# 已結束、尚未記錄成績的賽事保留在清單中的天數
RACE_LOOKBACK_DAYS=14
# 一則訊息最多呼叫幾輪工具
TOOL_CALL_MAX_ROUNDS=5
# 輸出上限含思考 token（只有實際輸出才計費）
MAX_RESPONSE_TOKENS=16000
