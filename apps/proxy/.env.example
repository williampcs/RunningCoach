# 薄代理（Node 進入點）的設定。複製為 apps/proxy/.env 後填入；.env 不會進版控。
#
#   本機執行：npm run dev -w @running-coach/proxy（讀取 apps/proxy/.env）
#   建置執行：npm run build -w @running-coach/proxy && node apps/proxy/dist/node.js
#
# Cloudflare Workers 進入點不讀這個檔案，設定方式見 apps/proxy/wrangler.toml。

# 轉發用的 Anthropic API key（代理營運者的 key，不是訂閱者的）
ANTHROPIC_API_KEY=sk-ant-...

# 管理端點（/admin/accounts…）的憑證；未設定時停用管理端點
ADMIN_TOKEN=

# 允許從瀏覽器呼叫的網頁來源，以逗號分隔；* 表示全部
ALLOWED_ORIGINS=http://localhost:5173

# 覆寫預設政策的 JSON（預設值見 src/policy.ts）。只會覆寫有給的欄位；models 會整組取代。
# 預設的價格與每月 3 美元預算只是佔位，上線前要依現行價目與定價調整。
# PROXY_POLICY={"defaultMonthlyBudgetUsd":5,"requestsPerMinute":20,"maxOutputTokens":16000}

# 帳號與用量的資料庫（不存任何對話內容）
# PROXY_DB_PATH=./data/proxy.db

# PORT=8787

# 上游位址；本機以模擬上游測試時指向 http://127.0.0.1:8788
# UPSTREAM_BASE_URL=https://api.anthropic.com
